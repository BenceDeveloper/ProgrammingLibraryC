# =============================================================================
#  proglib — C++20 header-only könyvtár
#  .gitattributes
#
#  Cél: konzisztens sorvégek és diff-megjelenítés minden platformon
#  (Windows CRLF ↔ Linux/macOS LF automatikus konverzió).
# =============================================================================

# -----------------------------------------------------------------------------
#  Alapértelmezett: minden szöveges fájlt Git kezeljen automatikusan
# -----------------------------------------------------------------------------
*                   text=auto

# -----------------------------------------------------------------------------
#  C++ forrásfájlok
# -----------------------------------------------------------------------------
*.cpp               text eol=lf
*.cxx               text eol=lf
*.cc                text eol=lf
*.c                 text eol=lf

*.hpp               text eol=lf
*.hxx               text eol=lf
*.h                 text eol=lf

# -----------------------------------------------------------------------------
#  Build és konfiguráció
# -----------------------------------------------------------------------------
CMakeLists.txt      text eol=lf
*.cmake             text eol=lf
*.cmake.in          text eol=lf
*.in                text eol=lf

# -----------------------------------------------------------------------------
#  Shell scriptek — LF kötelező (Windows CR töri a bash-t)
# -----------------------------------------------------------------------------
*.sh                text eol=lf
*.bash              text eol=lf

# Windows batch — CRLF (cmd.exe igényli)
*.bat               text eol=crlf
*.cmd               text eol=crlf
*.ps1               text eol=crlf

# -----------------------------------------------------------------------------
#  Dokumentáció és konfig
# -----------------------------------------------------------------------------
*.md                text eol=lf
*.txt               text eol=lf
*.yml               text eol=lf
*.yaml              text eol=lf
*.json              text eol=lf
*.toml              text eol=lf
.gitignore          text eol=lf
.gitattributes      text eol=lf

# -----------------------------------------------------------------------------
#  Bináris fájlok — soha ne konvertálja a Git
# -----------------------------------------------------------------------------
*.png               binary
*.jpg               binary
*.jpeg              binary
*.gif               binary
*.ico               binary
*.svg               binary

*.zip               binary
*.tar               binary
*.gz                binary
*.7z                binary

*.pdf               binary

# Előre fordított / linkelt kimenetek (ha véletlenül bekerülnének)
*.exe               binary
*.dll               binary
*.lib               binary
*.a                 binary
*.so                binary
*.dylib             binary
*.pch               binary
*.obj               binary
*.o                 binary

# -----------------------------------------------------------------------------
#  Diff driverek — értelmes diff C++ fájlokhoz GitHub/GitLab webes nézetben
# -----------------------------------------------------------------------------
*.cpp               diff=cpp
*.cxx               diff=cpp
*.cc                diff=cpp
*.c                 diff=cpp
*.hpp               diff=cpp
*.hxx               diff=cpp
*.h                 diff=cpp